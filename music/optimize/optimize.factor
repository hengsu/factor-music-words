! Factor Music Words -- automatic optimization (factorization).
!
! Two levels of the same idea: repeated material should be stated
! once and referenced afterwards.
!
! Phrase level: factor-phrase splits a phrase into segments of n
! notes and returns the table of distinct segments plus the index
! of the segment at each position -- a compressed representation.
! expand-phrase is its exact inverse.
!
! Score level: emit-optimized does automatically what was first
! done by hand for the Turkish March example. Given a score in the
! event model (voices of bars of { start midi dur } events), it
! prints a complete, factored Factor program: every distinct bar
! becomes a bar-N word, phrases of 8 bars are built from bar words
! with narray, repeated phrases are shared, and the voices are
! assembled with seq. The generated program's event output is
! identical to the unfactored score's.
USING: arrays grouping io kernel locals math math.parser sequences ;
IN: music.optimize

! --- phrase level ---

: segments ( phrase n -- segs ) group ;

<PRIVATE
:: (adjoin-distinct) ( acc elt -- acc' )
    elt acc member? [ acc ] [ acc elt suffix ] if ;

: (distinct) ( seq -- seq' )
    { } [ (adjoin-distinct) ] reduce ;
PRIVATE>

:: factor-phrase ( phrase n -- table indices )
    phrase n segments :> segs
    segs (distinct) :> table
    table segs [ table index ] map ;

:: expand-phrase ( table indices -- phrase )
    indices [ table nth ] map concat ;

! --- score level ---

<PRIVATE
: (bar-table) ( voices -- table ) concat (distinct) ;

:: (voice-indices) ( table voice -- indices )
    voice [ table index ] map ;

:: (chunk-nums) ( table chunks -- nums )
    chunks [ table index 1 + ] map ;

:: (phrase-table) ( indices -- table nums )
    indices 8 group :> chunks
    chunks (distinct) :> table
    table table chunks (chunk-nums) ;

: emit-event ( event -- )
    "{ " write [ number>string write " " write ] each "} " write ;

:: emit-bar-word ( n bar -- )
    ": bar-" write n number>string write " ( -- bar ) { " write
    bar [ emit-event ] each "} ;" print ;

:: (emit-bar-indexed) ( bar i -- )
    i 1 + bar emit-bar-word ;

:: emit-phrase-word ( name num chunk -- )
    ": " write name write "-" write num number>string write
    " ( -- voice ) " write
    chunk [ "bar-" write 1 + number>string write " " write ] each
    chunk length number>string write " narray ;" print ;

:: emit-voice ( name nums -- )
    ": " write name write " ( -- voice ) " write
    name write "-" write nums first number>string write
    nums rest
    [ " " write name write "-" write number>string write " seq" write ]
    each " ;" print ;
PRIVATE>

:: emit-optimized ( voices names bar-ticks pickup -- )
    "! Factored score, generated by emit-optimized (music.optimize)."
    print
    "USING: arrays io kernel locals math prettyprint sequences" print
    "    sequences.generalizations ;" print
    "IN: optimized-score" print "" print
    ": seq ( seq seq -- seq ) append ;" print
    ": par ( voice voice -- voices ) 2array ;" print "" print
    ": bar-offset ( index -- ticks )" print
    "    dup zero? [ drop 0 ] [ 1 - " write
    bar-ticks number>string write " * " write
    pickup number>string write " + ] if ;" print "" print
    ":: shift-event ( event offset -- event' )" print
    "    event first offset + event second event third 3array ;"
    print "" print
    ":: shift-bar ( bar offset -- events )" print
    "    bar [ offset shift-event ] map ;" print "" print
    ": voice-events ( voice -- events )" print
    "    [ bar-offset shift-bar ] map-index concat ;" print "" print
    ": score-events ( voices -- events )" print
    "    [ voice-events ] map concat ;" print "" print
    voices (bar-table) :> table
    table [ (emit-bar-indexed) ] each-index "" print
    voices [| voice vi |
        vi names nth :> name
        table voice (voice-indices) (phrase-table) :> nums :> ptable
        ptable [| chunk ci | name ci 1 + chunk emit-phrase-word ]
        each-index
        name nums emit-voice
    ] each-index "" print
    ": score ( -- voices ) " write
    names [ write " " write ] each
    names length number>string write " narray ;" print "" print
    ": main ( -- )" print
    "    score score-events [ first3 . . . ] each ;" print "" print
    "MAIN: main" print ;
